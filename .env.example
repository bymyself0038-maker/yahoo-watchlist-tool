# auctions.yahoo.co.jp/my/watchlist にログイン済みの状態で
# ブラウザの開発者ツール(Network タブ)から Cookie リクエストヘッダーの値を丸ごとコピーする
YAHOO_COOKIE=""

# Google Apps Script をウェブアプリとしてデプロイしたときに発行される URL
# 例: https://script.google.com/macros/s/xxxxxxxxxxxxxxxx/exec
APPS_SCRIPT_URL=""

# apps_script/Code.gs 側のスクリプトプロパティ SHARED_TOKEN と同じ値にする
# (誰でも叩けるURLになるため、簡易的な合言葉として使う)
APPS_SCRIPT_TOKEN=""

# (任意) 追記先の既存Googleドキュメントの URL。
# 設定すると、そのドキュメントの一番上に「見出し(終了日)+商品名リスト」を追記する。
# 空のままなら、実行のたびに新規ドキュメントを作成する。
DOC_URL=""
